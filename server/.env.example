# Copy to .env for local `docker compose up`; on Coolify set these in the UI.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-run-openssl-rand-hex-32
# Accept valid invitations only. Set false to pause all new accounts.
ALLOW_REGISTRATION=true
# Trusted owner/admin account emails: manage invitations and view food data and assistant traces.
# Set this to your owner account email. Empty disables admin access. Never use a web build variable.
ADMIN_EMAILS=
# Optional: free key from https://fdc.nal.usda.gov/api-key-signup for USDA search (web app and AI assistant)
USDA_API_KEY=
# Optional: Gemini API key (https://aistudio.google.com/apikey) to turn on the AI assistant
GEMINI_API_KEY=
