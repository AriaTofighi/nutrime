# Rendered by the nginx image's envsubst at startup (only NUTRIME_API_URL and
# NGINX_LOCAL_RESOLVERS are substituted; nginx's own $variables are left alone).
# Upstreams are set through variables so hostnames resolve per request: nginx starts even if DNS
# isn't ready yet, and follows the backend if its IP changes.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_static on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 20m;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
    resolver_timeout 5s;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # NutriMe sync API (the api service in the same compose stack). Same origin for the browser and
    # the phone app's server URL, so no CORS is needed.
    location /api/ {
        set $api_upstream ${NUTRIME_API_URL};
        proxy_pass $api_upstream;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /foods.json {
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
