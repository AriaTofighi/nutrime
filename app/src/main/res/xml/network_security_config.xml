<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so a self-hosted sync server on a LAN address (http://192.168.x.x)
     works during setup. Use HTTPS (Coolify provides it) for anything internet-facing. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
