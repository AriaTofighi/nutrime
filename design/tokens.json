{
  "$comment": "NutriMe design tokens: the single source of truth for the web app and the Android app. Edit this file, then run `python3 tools/gen_design_tokens.py` to regenerate web/src/theme/tokens.css, web/src/theme/tokens.ts and the Android DesignTokens.kt. CI fails if the generated files are stale.",

  "typography": {
    "fontFamily": "\"Inter Variable\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "size": { "2xs": 11, "xs": 12, "sm": 12.5, "md": 13, "base": 14, "lg": 16, "xl": 18, "2xl": 22, "3xl": 30, "4xl": 36 },
    "weight": { "regular": 420, "medium": 520, "semibold": 600, "bold": 680 },
    "tracking": { "tight": -0.022, "wide": 0.06 }
  },

  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },

  "radius": { "xs": 3, "sm": 5, "md": 7, "lg": 10, "xl": 14, "2xl": 20, "full": 999 },

  "motion": {
    "easeOut": [0.22, 1, 0.36, 1],
    "durationFast": 120,
    "duration": 200,
    "durationSlow": 420
  },

  "control": { "hSm": 28, "h": 34, "hLg": 40, "rowH": 48 },

  "layout": { "sidebarWidth": 216, "railWidth": 288, "contentMax": 1240 },

  "accents": {
    "default": "emerald",
    "options": {
      "emerald": { "label": "Emerald", "h": 158, "s": 64, "swatchL": 40 },
      "indigo": { "label": "Indigo", "h": 238, "s": 72, "swatchL": 58 },
      "rose": { "label": "Rose", "h": 346, "s": 74, "swatchL": 52 },
      "amber": { "label": "Amber", "h": 32, "s": 90, "swatchL": 48 }
    }
  },

  "themes": {
