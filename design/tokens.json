        "0": "#ffffff", "25": "#fbfbfa", "50": "#f6f6f4", "100": "#eeeeeb", "200": "#e3e3df", "300": "#cfcfca",
        "400": "#a5a59f", "500": "#7b7b75", "600": "#5d5d58", "700": "#3f3f3b", "800": "#262624", "900": "#161615"
      },
      "semantic": {
